# Local development: Press Ctrl+F5 - agent runs locally and loads its environment variables from the .env file in the root of the project.
AZURE_ENV_NAME=echo9-dev

# Foundry project endpoint — auto-injected in hosted containers
FOUNDRY_PROJECT_ENDPOINT=https://foundry-app-resource.services.ai.azure.com/api/projects/foundry-app

# Model deployment name — must match a deployment in your Foundry project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
